# GP Copilot — copy to .env and fill in your values
# cp .env.example .env

# LLM provider: groq | openai | google
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here
# OPENAI_API_KEY=your_openai_key_here
# GOOGLE_API_KEY=your_google_key_here

LLM_MODEL=llama-3.3-70b-versatile
LLM_DEMO_MODE=false

# Flask session secret (change in production)
FLASK_SECRET=gp-copilot-demo-secret-2026

# Patient portal base URL (used when doctor app generates secure links)
PORTAL_BASE_URL=http://localhost:5101
